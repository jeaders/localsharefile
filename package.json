  },
  "scripts": {
    "dev": "next dev",
    "dev:https": "tsx https-proxy.ts --dev",
    "build": "next build",
    "start": "next start -H 127.0.0.1",
    "start:https": "tsx https-proxy.ts",
    "helper": "npm --prefix helper start",
    "helper:install": "npm --prefix helper install",
    "server": "./start-server.sh",
    "server:stop": "./stop-server.sh",
    "cert": "./scripts/gen-cert.sh",
    "db:migrate": "tsx migrate.ts",
    "db:generate": "drizzle-kit generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "dotenv": "17.3.1",
    "drizzle-orm": "0.45.2",
    "lucide-react": "^1.52.0",
    "next": "16.2.6",
