# Connessione al database PostgreSQL (Neon, Supabase, Postgres locale...)
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/app_db

# Se il provider usa un certificato non verificabile, metti "false".
# Il valore sicuro (predefinito) e' "true".
# DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Token di accesso condiviso. Se lo lasci vuoto viene generato in data/nodo-token.
# NODO_TOKEN=

# Porte del server
# NODO_HTTP_PORT=3000
# NODO_HTTPS_PORT=3443

# Origini extra ammesse dal dev server (separate da virgola, senza schema)
# NODO_ALLOWED_ORIGINS=192.168.1.10:3000,192.168.1.10:3443

# Dimensione massima di un upload, in MB
# NODO_MAX_UPLOAD_MB=2048
